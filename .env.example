# Copie para .env e preencha. O .env NÃO vai para o Git.

# Criação do primeiro administrador (usado apenas quando o banco está vazio).
# Sem estas duas variáveis nenhum admin é criado e o painel fica sem acesso.
ADMIN_EMAIL=troque@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-8-ou-mais-caracteres

# Porta do servidor de produção (padrão do nitro: 3000)
PORT=4904

# Defina como "1" SOMENTE se estiver atrás de um proxy confiável
# (nginx, Caddy, Cloudflare). Isso libera o uso de X-Forwarded-For.
# TRUST_PROXY=1

# Gateway PIX
# Escolha: asaas ou mercadopago
PAYMENT_PROVIDER=asaas

# Asaas — Sandbox: https://api-sandbox.asaas.com
# Produção: https://api.asaas.com
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_ACCESS_TOKEN=

# Mercado Pago — Access Token deve ficar somente no servidor/.env
MERCADOPAGO_ACCESS_TOKEN=

# Segurança dos Webhooks
ASAAS_WEBHOOK_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Web Push (as chaves VAPID são geradas e persistidas automaticamente no banco)
# Use um e-mail real do administrador para identificar o servidor de push.
VAPID_SUBJECT=mailto:seu-email@dominio.com
